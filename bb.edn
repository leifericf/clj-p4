{:paths ["src" "test"]

 :deps {org.clojure/test.check {:mvn/version "1.1.1"}}

 :tasks
 {test
  {:doc "Run the pure-layer tests under Babashka. The shell-layer is
         JVM-/Babashka-shared (`babashka.process`) and exercised by the
         JVM job; the pure layers are the ones that benefit from a
         distinct runtime catching accidental java.* interop."
   :requires ([clojure.test :as t]
              [clj-p4.spec-test]
              [clj-p4.parse.semantic-test]
              [clj-p4.view-test]
              [clj-p4.exclude-test]
              [clj-p4.plan-test])
   :task (let [{:keys [fail error]}
               (t/run-tests 'clj-p4.spec-test
                            'clj-p4.parse.semantic-test
                            'clj-p4.view-test
                            'clj-p4.exclude-test
                            'clj-p4.plan-test)]
           (when (pos? (+ (or fail 0) (or error 0)))
             (System/exit 1)))}}}
