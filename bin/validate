#!/usr/bin/env bash
# bin/validate — operator-facing CLI wrapper around clj-p4.validate.
#
# The validate harnesses are JVM-only (they walk a bare git repo via
# `git ls-tree` / `git cat-file` and call into `clj-p4.shell.p4`), so
# this script just dispatches `clojure -X` rather than doing the work
# itself.
#
# Usage:
#   bin/validate tip   --target /path/to/repo.git --source //stream/main
#                      [--port localhost:1666] [--user alice] [--ref refs/heads/main]
#
#   bin/validate deep  --target /path/to/repo.git --source //stream/main
#                      [--port ...] [--user ...] [--ref ...]
#                      [--sample 10 | --sample :all]
#
# Output is the EDN value clj-p4.validate returns.

set -euo pipefail

cmd="${1:-}"
shift || true

target=""
source=""
port="${P4PORT:-localhost:1666}"
user="${P4USER:-alice}"
ref="refs/heads/main"
sample="10"

while (( $# )); do
  case "$1" in
    --target) target="$2"; shift 2;;
    --source) source="$2"; shift 2;;
    --port)   port="$2"; shift 2;;
    --user)   user="$2"; shift 2;;
    --ref)    ref="$2"; shift 2;;
    --sample) sample="$2"; shift 2;;
    -h|--help)
      sed -n '2,17p' "$0"; exit 0;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done

if [[ -z "$target" || -z "$source" ]]; then
  echo "--target and --source are required" >&2
  exit 2
fi

case "$cmd" in
  tip)
    exec clojure -X clj-p4.validate/validate-tip \
      :conn   "{:p4/port \"$port\" :p4/user \"$user\"}" \
      :target "\"$target\"" \
      :source "\"$source\"" \
      :ref    "\"$ref\""
    ;;
  deep)
    if [[ "$sample" == ":all" ]]; then
      sample_arg=":all"
    else
      sample_arg="$sample"
    fi
    exec clojure -X clj-p4.validate/validate-deep! \
      :conn   "{:p4/port \"$port\" :p4/user \"$user\"}" \
      :target "\"$target\"" \
      :source "\"$source\"" \
      :ref    "\"$ref\"" \
      :sample "$sample_arg"
    ;;
  ""|-h|--help)
    sed -n '2,17p' "$0"
    exit 0
    ;;
  *)
    echo "unknown subcommand: $cmd" >&2
    echo "valid: tip, deep" >&2
    exit 2
    ;;
esac
